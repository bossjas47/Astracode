{
  "name": "astracode-desktop",
  "version": "0.2.1",
  "description": "AstraCode Desktop: AI agent that works on files, commands and MCP tools on your computer",
  "main": "main.js",
  "author": "AstraCode",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-force-exit test/agent.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "xyz.panderx.astracode.desktop",
    "productName": "AstraCode Desktop",
    "files": ["main.js", "preload.js", "preload-web.js", "agent.js", "tools.js", "mcp.js", "renderer/**"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "AstraCode-Desktop-Setup-${version}.exe" }
  }
}
