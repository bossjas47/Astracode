{
  "name": "astracode-desktop",
  "version": "0.4.0",
  "description": "AstraCode Desktop: the AstraCode website in an app window, with access to files, commands and MCP tools on your computer",
  "main": "main.js",
  "author": "AstraCode",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-force-exit test/localfs.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.4",
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "xyz.panderx.astracode.desktop",
    "productName": "AstraCode Desktop",
    "files": [
      "main.js",
      "preload-web.js",
      "tools.js",
      "mcp.js",
      "localfs.js",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AstraCode-Desktop-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/bossjas47/Astracode/releases/download/desktop-latest"
      }
    ],
    "protocols": [
      {
        "name": "AstraCode",
        "schemes": [
          "astracode"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "AstraCode-Desktop-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "AstraCode-Desktop-linux.${ext}"
    }
  }
}
