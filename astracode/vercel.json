{
  "outputDirectory": "vercel-static",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "https://astracode.babkoral1.workers.dev/"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?__p=api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/proxy?__p=v1/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/proxy?__p=api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/proxy?__p=api/sitemap"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/proxy?__p=api/page/blog/:slug"
    },
    {
      "source": "/:path*",
      "destination": "https://astracode.babkoral1.workers.dev/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/index(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home(.html)?",
      "destination": "/",
      "permanent": true
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- api vercel.json vercel-static"
}
